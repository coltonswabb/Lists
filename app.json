{
  "expo": {
    "name": "Decree",
    "slug": "decree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coltonswabb.decree"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181614",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coltonswabb.decree"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#181614",
    "scheme": "decree",
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.coltonswabb.decree",
          "widgets": [
            {
              "name": "ListsScroll",
              "displayName": "Scroll",
              "description": "What is left on your scroll, at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/ScrollWidget.tsx"
              }
            }
          ],
          "frequentUpdates": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#181614"
        }
      ],
      "expo-sharing",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Vigil",
            "ios": "./assets/icons/vigil.png",
            "android": {
              "foregroundImage": "./assets/icons/vigil-foreground.png",
              "backgroundColor": "#0c0b0a"
            }
          },
          {
            "name": "Lapis",
            "ios": "./assets/icons/lapis.png",
            "android": {
              "foregroundImage": "./assets/icons/lapis-foreground.png",
              "backgroundColor": "#10141d"
            }
          },
          {
            "name": "Verdant",
            "ios": "./assets/icons/verdant.png",
            "android": {
              "foregroundImage": "./assets/icons/verdant-foreground.png",
              "backgroundColor": "#121610"
            }
          },
          {
            "name": "Codex",
            "ios": "./assets/icons/codex.png",
            "android": {
              "foregroundImage": "./assets/icons/codex-foreground.png",
              "backgroundColor": "#120c16"
            }
          }
        ]
      ]
    ]
  }
}
